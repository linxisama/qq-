+def _tool_sender(runtime=None) -> str:
+    """本次工具调用是谁发起的（tool.guard 的 context.senderId）。
+
+    工具钩子的签名里没有发送者，硬加参数要改 manager / tool_loop 三层调用链；
+    而 `src/skill_tools.py` 已经在工具环外面用 ContextVar 绑了本轮消息
