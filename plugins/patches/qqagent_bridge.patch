+    拿不到发送者时自己决定是放行还是拒绝，桥不编造。
+    """
+    if runtime is None:
+        return ''
+    try:
+        from src import skill_tools
+    except Exception:
+        return ''
+    getter = getattr(skill_tools, 'runtime_tool_context', None)
+    if not callable(getter):
